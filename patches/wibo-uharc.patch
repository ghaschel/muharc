+
+namespace {
+
+struct ConsoleInputState {
+	std::mutex mutex;
+	std::deque<char> pendingCharacters;
+	int terminalFd = -1;
+	bool terminalModeChanged = false;
+	termios originalTerminalMode{};
+
+	bool enableSingleCharacterInput(int fd) {
+		if (!isatty(fd)) {
+			return true;
+		}
+		if (terminalModeChanged && terminalFd == fd) {
+			return true;
+		}
+		restoreTerminalMode();
+		if (tcgetattr(fd, &originalTerminalMode) != 0) {
+			return false;
+		}
+		termios singleCharacterMode = originalTerminalMode;
+		singleCharacterMode.c_lflag &= static_cast<tcflag_t>(~ICANON);
+		singleCharacterMode.c_cc[VMIN] = 1;
+		singleCharacterMode.c_cc[VTIME] = 0;
+		if (tcsetattr(fd, TCSANOW, &singleCharacterMode) != 0) {
+			return false;
+		}
+		terminalFd = fd;
+		terminalModeChanged = true;
+		return true;
+	}
+
+	void restoreTerminalMode() {
+		if (terminalModeChanged) {
+			(void)tcsetattr(terminalFd, TCSANOW, &originalTerminalMode);
+			terminalFd = -1;
+			terminalModeChanged = false;
+		}
+	}
+};
+
+ConsoleInputState g_consoleInput;
+
+void fillKeyEvent(INPUT_RECORD &record, char character) {
+	std::memset(&record, 0, sizeof(record));
+	record.EventType = KEY_EVENT;
+	record.Event.KeyEvent.bKeyDown = TRUE;
+	record.Event.KeyEvent.wRepeatCount = 1;
+	record.Event.KeyEvent.uChar.AsciiChar = character;
+}
+
+bool readConsoleCharacter(int fd, char &character) {
+	while (true) {
+		ssize_t count = ::read(fd, &character, 1);
+		if (count == 1) {
+			return true;
+		}
+		if (count == 0) {
+			errno = EPIPE;
+			return false;
+		}
+		if (errno != EINTR) {
+			return false;
+		}
+	}
+}
+
+bool validateConsoleInput(HANDLE handle, Pin<FileObject> &file) {
+	file = wibo::handles().getAs<FileObject>(handle);
+	if (!file || !file->valid()) {
+		kernel32::setLastError(ERROR_INVALID_HANDLE);
+		return false;
+	}
+	return true;
+}
